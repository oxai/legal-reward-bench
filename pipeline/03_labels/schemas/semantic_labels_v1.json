{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "faithfulness",
    "correctness",
    "completeness",
    "conciseness"
  ],
  "properties": {
    "faithfulness": {
      "type": "string",
      "enum": [
        "fully_supported",
        "partially_supported",
        "unsupported",
        "contradicted"
      ]
    },
    "correctness": {
      "type": "string",
      "enum": ["correct", "incorrect"]
    },
    "completeness": {
      "type": "string",
      "enum": ["complete", "incomplete"]
    },
    "conciseness": {
      "type": "string",
      "enum": ["concise", "acceptable", "not_concise"]
    }
  }
}
