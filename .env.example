PYTHONPATH=.
PYTHONUTF8=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Required for DigitalOcean-hosted LiteLLM model ids such as
# digitalocean/alibaba-qwen3-32b and digitalocean/openai-gpt-oss-120b.
DIGITAL_OCEAN_ACCESS_TOKEN=

# Required only when a Hugging Face model or dataset is gated/private.
HUGGING_FACE_HUB_TOKEN=
HF_HOME=

# Optional local smoke-test endpoint for Ollama models.
OLLAMA_HOST=http://localhost:11434
